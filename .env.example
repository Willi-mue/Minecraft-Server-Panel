# Copy to .env and adjust.

# Password for the web panel (required: the app refuses to start without it)
PANEL_PASSWORD=

# Time zone for logs and backup names (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Berlin

# Default server type and version (both can be changed in the web panel)
# MC_FLAVOR: paper (PaperMC, performance-optimized, default) or vanilla (Mojang)
MC_FLAVOR=paper
# Empty = choose in the panel; nothing is downloaded until a version is chosen
MC_VERSION=

# Java heap for the Minecraft server (can be changed in the web panel)
MIN_RAM=1G
MAX_RAM=3G

# Live map (works with every server type); can be switched in the web panel
MAP_ENABLED=true
# CPU threads the map renderer may use, and seconds between update checks while the server runs
MAP_THREADS=2
MAP_INTERVAL=60

# Number of backups to keep (oldest are deleted)
BACKUP_KEEP=7
# Automatic backup every N hours while the server runs (0 = off)
BACKUP_INTERVAL_HOURS=24
# Folder for backups on this machine, e.g. D:/Backups/minecraft or /mnt/nas/minecraft
# Empty = ./data/backups (default)
BACKUP_DIR=

# Host ports (docker compose only)
# Admin panel: keep private
WEB_PORT_HOST=47318
# Minecraft
MC_PORT_HOST=25565
# Live map: can be shared with players
MAP_PORT_HOST=47319

# Extra Java runtimes in the image besides Java 25 (rebuild after changing).
# 21 = Minecraft 1.20.5-1.21.x, 17 = 1.17-1.20.4, 8 = up to 1.16. Fewer = smaller image.
EXTRA_JAVA=21

# Development mode: use the panel code from this folder (HTML/CSS/JS changes are live without
# rebuilding; Python changes need `docker compose restart`). Remove for a self-contained setup.
# Separator: ";" on Windows, ":" on Linux/macOS.
COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml
