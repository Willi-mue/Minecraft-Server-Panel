execute unless data storage nightly:last r run return run tellraw @s {text: "Noch keine Nachtbilanz – die erste gibt es beim nächsten Sonnenaufgang.", color: "gray"}
tellraw @s [{text: "☾ ", color: "gold"}, {text: "Bilanz der letzten Nacht:", color: "yellow"}]
execute if data storage nightly:last r.kills run tellraw @s [{text: "  ⚔ Meiste Mobs besiegt: ", color: "gray"}, {nbt: "r.kills.name", storage: "nightly:last", interpret: true, color: "gold"}, {text: " (", color: "gray"}, {nbt: "r.kills.n", storage: "nightly:last", color: "white"}, {text: ")", color: "gray"}]
execute if data storage nightly:last r.deaths run tellraw @s [{text: "  ☠ Am häufigsten gestorben: ", color: "gray"}, {nbt: "r.deaths.name", storage: "nightly:last", interpret: true, color: "gold"}, {text: " (", color: "gray"}, {nbt: "r.deaths.n", storage: "nightly:last", color: "white"}, {text: "×)", color: "gray"}]
execute if data storage nightly:last r.walk run tellraw @s [{text: "  ➜ Am weitesten gelaufen: ", color: "gray"}, {nbt: "r.walk.name", storage: "nightly:last", interpret: true, color: "gold"}, {text: " (", color: "gray"}, {nbt: "r.walk.n", storage: "nightly:last", color: "white"}, {text: " Blöcke)", color: "gray"}]
execute unless data storage nightly:last r.kills unless data storage nightly:last r.deaths unless data storage nightly:last r.walk run tellraw @s {text: "  Es war eine ruhige Nacht.", color: "gray"}
execute if score @s nightly.lk matches 0.. run tellraw @s [{text: "  Du: ", color: "gray"}, {score: {name: "@s", objective: "nightly.lk"}, color: "white"}, {text: " Mobs, ", color: "gray"}, {score: {name: "@s", objective: "nightly.ld"}, color: "white"}, {text: " Tode, ", color: "gray"}, {score: {name: "@s", objective: "nightly.lw"}, color: "white"}, {text: " Blöcke gelaufen", color: "gray"}]
